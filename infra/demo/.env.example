# The public demo (infra/demo/README.md). `./demo.sh init` copies this to .env, fills the domain and generates
# every secret; edit by hand only what you want to change.

APP_DOMAIN=demo.workspace.dev
APP_URL=https://demo.workspace.dev
FILES_DOMAIN=
LETSENCRYPT_EMAIL=

# Generated by ./demo.sh init.
POSTGRES_PASSWORD=
PG_OWNER_PASSWORD=
PG_APP_PASSWORD=
INTERNAL_TOKEN_SECRET=
AUTH_SECRET=
SESSION_SECRET=
SETUP_TOKEN=

# Files: the demo keeps uploads on local disk (the `demofiles` volume, wiped by every reset), served by the app at
# APP_URL/storage/. For S3 instead: STORAGE_DRIVER=s3, S3_ENDPOINT=https://<FILES_DOMAIN>, FILES_DOMAIN set and `s3`
# in COMPOSE_PROFILES (the bundled SeaweedFS).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The demo sends no email (no SMTP_URL): visitors cannot invite anyone, and the seed sets passwords directly.

# Demo mode. The three quick sign-in accounts: the owner below, and the seed's members minh@example.com (manager) and
# bao@example.com (staff) with DEMO_PASSWORD. Nobody types these; the quick sign-in buttons use them server-side.
DEMO_OWNER_EMAIL=admin@example.com
DEMO_OWNER_PASSWORD=
DEMO_PASSWORD=
# Lets the seed through the demo locks (invitations, activation). Never put it anywhere a browser sees.
DEMO_SEED_SECRET=
# Requests per visitor IP and minute, and seconds between resets.
DEMO_RATE_PER_IP_PER_MIN=120
DEMO_RESET_SECONDS=3600
# Language of the demo: `en` (workspace in English and UTC, English demo data) or `vi` (Vietnamese, Asia/Ho_Chi_Minh).
# Visitors can still switch the UI language in the menu. Change it before the first start (the seed runs once).
DEMO_LOCALE=en
# Company name shown everywhere; empty picks one that fits DEMO_LOCALE.
DEMO_COMPANY=

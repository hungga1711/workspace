{
  "name": "workspace",
  "version": "1.0.0",
  "description": "A self-hosted work app for one company: tasks, chat, docs, requests and time, with the company's own AI and AI Insights.",
  "homepage": "https://github.com/hungga1711/workspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungga1711/workspace.git"
  },
  "bugs": "https://github.com/hungga1711/workspace/issues",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./backend/packages/**\" run build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "infra:up": "docker compose -f infra/local/docker-compose.yml up -d",
    "infra:db": "docker compose -f infra/local/docker-compose.yml up -d postgres",
    "infra:down": "docker compose -f infra/local/docker-compose.yml down",
    "dev:server": "node tooling/scripts/dev-server.mjs",
    "desktop:build": "node tooling/scripts/desktop-build.mjs",
    "migrate": "node tooling/scripts/migrate-all.mjs",
    "test:db": "node tooling/scripts/test-db.mjs",
    "test:server": "node tooling/scripts/test-db.mjs --serve",
    "seed:demo": "node tooling/scripts/seed-demo.mjs",
    "demo:refresh": "node tooling/scripts/demo-refresh.mjs",
    "events:catalog": "node tooling/scripts/events-catalog.mjs",
    "api:openapi": "node tooling/scripts/openapi.mjs",
    "ops:dlq": "node backend/packages/service-kit/dist/cli/dlq.js",
    "ops:reindex": "node backend/server/dist/modules/search/reindex-cli.js",
    "lint": "eslint backend frontend/browser-extension tooling && pnpm --filter @workspace/web lint",
    "format": "prettier --write \"backend/**/*.{ts,mjs}\" \"frontend/**/*.{ts,tsx,js,mjs,css}\" \"tooling/**/*.mjs\"",
    "format:check": "prettier --check \"backend/**/*.{ts,mjs}\" \"frontend/**/*.{ts,tsx,js,mjs,css}\" \"tooling/**/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vercel/nft": "1.11.2",
    "esbuild": "0.28.2",
    "eslint": "9.17.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

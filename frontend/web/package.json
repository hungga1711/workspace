{
  "name": "@workspace/web",
  "description": "workspace web app (Next.js): the employee and manager UI, admin and first-run setup",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "DEV_BUNDLER=webpack node scripts/dev.mjs",
    "postinstall": "node scripts/excalidraw-assets.mjs",
    "build": "node scripts/excalidraw-assets.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test:e2e": "playwright test",
    "test:ext": "playwright test -c playwright.extension.config.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "lint": "eslint src",
    "i18n:drift": "tsx scripts/i18n-drift.mts",
    "ext:zip": "mkdir -p public/downloads && rm -f public/downloads/workspace-ai.zip && cd ../browser-extension && zip -q -X -r ../web/public/downloads/workspace-ai.zip manifest.json background.js sites.js content.js hint.js options.html options.js icon128.png icons _locales"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@livekit/components-react": "2.9.24",
    "@tanstack/react-virtual": "3.11.2",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-collaboration": "2.27.3",
    "@tiptap/extension-collaboration-cursor": "2.27.3",
    "@tiptap/extension-highlight": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-mention": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "3.34.0",
    "@tiptap/extension-task-item": "2.27.3",
    "@tiptap/extension-task-list": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@tiptap/suggestion": "2.27.3",
    "fflate": "0.8.2",
    "livekit-client": "2.22.4",
    "marked": "15.0.6",
    "motion": "13.4.1",
    "next": "15.1.12",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "server-only": "0.0.1",
    "socket.io-client": "4.8.1",
    "source-map-js": "1.2.1",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/eslintrc": "3.2.0",
    "@next/bundle-analyzer": "15.1.12",
    "@playwright/test": "1.49.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.12",
    "postcss": "8.4.49",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

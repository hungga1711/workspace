{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workspace",
  "version": "1.0.1",
  "identifier": "app.workspace.desktop",
  "build": {
    "frontendDist": "../connect"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http: https:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["workspace"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Work management for your company",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

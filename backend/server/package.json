{
  "name": "@workspace/server",
  "description": "The backend: one process hosting every module (gateway, identity, platform, search, chat, home, work, employee, ai), each with its own folder, schema, role, migrations and HTTP API",
  "license": "MIT",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "reindex": "node dist/modules/search/reindex-cli.js",
    "eval": "tsx evals/run.ts",
    "task-sync:check": "tsx src/modules/work/task-sync/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@workspace/contracts": "workspace:*",
    "@workspace/service-kit": "workspace:*",
    "@workspace/shared": "workspace:*",
    "bcrypt": "6.0.0",
    "docx": "9.15.4",
    "express": "4.22.3",
    "jose": "5.10.0",
    "jszip": "3.10.2",
    "livekit-server-sdk": "2.20.0",
    "marked": "15.0.12",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pptxgenjs": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.2",
    "socket.io": "4.8.4",
    "unpdf": "1.9.1",
    "web-push": "3.6.7",
    "yjs": "13.6.33",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "4.17.21",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/web-push": "3.6.4",
    "@workspace/testkit": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "socket.io-client": "4.8.4"
  }
}

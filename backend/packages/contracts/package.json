{
  "name": "@workspace/contracts",
  "description": "Event envelope and payload schemas shared by every service (the event catalog), and the public API schemas",
  "license": "MIT",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/api/openapi.d.ts",
      "default": "./dist/api/openapi.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@workspace/tsconfig": "workspace:*"
  }
}

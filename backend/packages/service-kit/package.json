{
  "name": "@workspace/service-kit",
  "description": "NestJS service toolkit: principal middleware, migrations, in-process events over the outbox, object storage, email",
  "license": "MIT",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@workspace/contracts": "workspace:*",
    "@workspace/shared": "workspace:*",
    "jose": "5.10.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@workspace/tsconfig": "workspace:*",
    "express": "4.22.3"
  }
}

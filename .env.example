# Copy to .env (gitignored). tooling/scripts/dev-server.mjs loads it for the backend server.

# ── Sign-in (identity module; backend/server/src/modules/identity/auth) ──
# Passwords are hashed with bcrypt; access tokens are Ed25519 JWTs (10 minutes) whose signing keys,
# like TOTP seeds and company IdP client secrets, are stored encrypted with a key derived from
# AUTH_SECRET (default: derived from INTERNAL_TOKEN_SECRET). Production refuses the dev default.
# AUTH_SECRET=
# AUTH_REFRESH_DAYS=30          # a refresh token lives this long (renewed on every use)
# AUTH_SESSION_MAX_DAYS=90      # a session ends after this, whatever the refreshes
# AUTH_KEY_ROTATE_DAYS=30       # a new signing key this often (the old one verifies one more day)
# LOGIN_LOCK_AFTER=5            # wrong passwords before an email is locked (30 s, doubling to 15 min)
# BCRYPT_COST=12

# ── AI (optional; backend/server/src/modules/ai/gateway.ts) ─────────────────
# workspace runs without AI. A vendor is enabled by its key (or OPENAI_BASE_URL for an
# OpenAI-compatible server such as Ollama, vLLM, LM Studio, LiteLLM). With none, the ai module reports
# `configured: false` (GET /api/ai/status): the web hides Trợ lý AI, @AI, the Home brief, summarize,
# translate and the task/doc AI panels, and those endpoints answer 503 ai_not_configured.
# Extension monitoring (Công việc › AI, Của tôi › AI) works either way.
# Usually nothing is needed here: admins connect AI in Admin › Kết nối AI (API key, OpenAI-compatible
# LLM API, or a self-hosted model such as Ollama). Env vendors below are an alternative for operators.
# Keys entered there are encrypted with AI_SECRETS_KEY (default: derived from INTERNAL_TOKEN_SECRET;
# changing either means re-entering the keys).
# AI_SECRETS_KEY=

# Task sync (Admin › Integrations › Task sync: Asana, ClickUp, Linear, Jira Cloud; docs/integrations/task-sync.md).
# Tokens are encrypted with TASK_SYNC_SECRETS_KEY (default: derived from INTERNAL_TOKEN_SECRET). Runs every 15 min.
# TASK_SYNC_SECRETS_KEY=
# TASK_SYNC_INTERVAL_MS=900000
# Integrations hub (Admin › Integrations: GitHub, GitLab, Figma on tasks; docs/integrations/hub.md). Tokens are
# encrypted with INTEGRATIONS_SECRETS_KEY (default: derived from INTERNAL_TOKEN_SECRET). Watched repositories are
# looked through for pull and merge requests naming a task code every 10 min.
# INTEGRATIONS_SECRETS_KEY=
# INTEGRATION_SCAN_INTERVAL_MS=600000
# Workflows that start by themselves (docs/architecture/agent-workflows.md, "Triggers"): how often what is waiting to
# start is started. Schedules are looked at once a minute whatever this is.
# WORKFLOW_TRIGGERS_INTERVAL_MS=10000
# Agent runs in flight are checked this often: a server run left by a restart resumes, a run whose runner went away
# goes back in the queue.
# AGENT_RUNS_WATCH_INTERVAL_MS=60000
# Uploaded files (PDF, Word, Excel, PowerPoint) are read into text for search and the AI this often.
# FILE_TEXT_INTERVAL_MS=60000
# MCP servers the company AI may use (Admin › Kết nối AI › Máy chủ MCP) must be https on the public internet:
# loopback, private, link-local (cloud metadata) and other reserved addresses are refused. To use the company's own
# internal MCP servers, list their hosts (exact names, *.suffix, IP addresses, or * for any); listed hosts may also
# use plain http. docs/integrations/mcp-client.md
# MCP_ALLOW_PRIVATE_HOSTS=mcp.corp.internal,10.0.4.12
# Tests and demos only: run the built-in extractive model as the company AI (no provider needed; answers come
# from workspace data). Never set in production. CI sets it for the AI end-to-end tests.
# AI_LOCAL_MODEL=1
# Answers reuse a tool's result for 90 s until the data behind it changes; 0 turns that off.
# AI_TOOL_CACHE=0
# How much of a task (description, comments, files) the task's Ask AI reads, in characters (minimum 2000).
# AI_TASK_BRIEF_CHARS=12000
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # OpenAI-compatible server; key optional

# Optional. Primary vendor when several keys are set (gemini | anthropic | openai | local).
# AI_PROVIDER=gemini
# Optional. Routes are "<provider>:<model>"; defaults come from the primary vendor.
# AI_MODEL_FAST=gemini:gemini-3.8-flash      # summaries, extraction, briefs
# AI_MODEL_SMART=gemini:gemini-3.8-flash     # Q&A and agents with tools
# Optional. Per-feature override (feature = metering name, e.g. ask, thread_summary, brief).
# AI_ROUTES={"thread_summary":"gemini:gemini-3.5-flash-lite"}
# Optional. Tried in order when a route fails with timeout / 429 / 5xx.
# Default with a hosted vendor: local:local-extractive (degrade instead of failing). "none" disables.
# AI_FALLBACK=anthropic:claude-sonnet-5-5,local:local-extractive
# Optional. Gemini 3 thinking level (minimal | low | medium | high). Default: low.
# GEMINI_THINKING_LEVEL=low

# ── File storage (backend/packages/service-kit/src/storage.ts, local-storage.ts) ─
# STORAGE_DRIVER=s3|local. Unset: S3 when S3_ENDPOINT is set or in development (the SeaweedFS container on
# :8333, dev keys built in); local disk in production without S3_ENDPOINT. Local disk keeps the signed-URL flow:
# the server serves <STORAGE_PUBLIC_URL>/storage/<token> (default APP_URL, http://localhost:4000 in dev)
# from STORAGE_LOCAL_DIR.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/data/files
# STORAGE_PUBLIC_URL=http://localhost:4000
# Extra origins the browser may upload to / read files from (Content-Security-Policy of the web app). Derived from
# S3_ENDPOINT / STORAGE_PUBLIC_URL; set it when a production build runs against the local SeaweedFS container.
# STORAGE_PUBLIC_ORIGIN="http://localhost:8333 http://localhost:4000"
# The S3 address browsers use when it differs from S3_ENDPOINT (the server's own address for the store).
# S3_PUBLIC_ENDPOINT=https://files.example.com

# ── Video meetings (backend/server/src/modules/work/rooms.ts) ────────────
# LiveKit SFU (open source, Apache 2.0). Media goes browser ⇄ SFU; the server only signs join tokens.
# Local: `pnpm infra:up` starts it on :7880 with the dev key below. Production: self-host LiveKit
# (or LiveKit Cloud) close to users and put its wss:// URL here; the web app needs the same URL
# for its Content-Security-Policy (frontend/web LIVEKIT_URL).
# In development the local LiveKit container is the default; production has no fallback (unset = no video).
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_URL=http://localhost:7880
# LIVEKIT_API_KEY=workspace_dev
# LIVEKIT_API_SECRET=workspace-dev-livekit-secret-change-me-32b
# Recordings: LiveKit Egress composes the room into an MP4 and uploads it straight to object storage
# (any S3-compatible store, e.g. Cloudflare R2). Off unless set to "on".
# Start the recorder locally with: LIVEKIT_CONFIG=livekit-recording.yaml docker compose -f infra/local/docker-compose.yml --profile recording up -d
# MEET_RECORDING=on
# Where the Egress worker uploads (defaults to S3_ENDPOINT; locally the container sees SeaweedFS as s3:8333).
# For R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
# RECORDING_S3_ENDPOINT=http://s3:8333
# Days a meeting recording is kept before the daily sweep deletes it (work module).
# MEET_RECORDING_RETENTION_DAYS=365
# How often the recording retention sweep runs, in ms (default: 24 h).
# RECORDING_SWEEP_INTERVAL_MS=86400000
# How long a one-to-one call rings before it counts as missed, in ms (chat module).
# CALL_RING_MS=30000

# ── Web ─────────────────────────────────────────────────────────────────────
# Public address of this installation (links in emails, CSP). Default: http://localhost:3000.
# APP_URL=http://localhost:3000
# How many reverse proxies sit in front of the web app (per-IP limits read X-Forwarded-For from the right)
TRUSTED_PROXY_HOPS=1

# ── Limits and background jobs ──────────────────────────────────────────────
# Requests per signed-in user per minute at the gateway.
# RATE_USER_PER_MIN=600
# Reads the web app makes while rendering a page have their own bucket per user (default 5× the limit above).
# RATE_SSR_READS_PER_MIN=3000
# Sign-ups per IP and hour at the gateway (E2E runs raise it), and the per-IP base for the public auth endpoints
# (password reset; sign-in, token refresh and password set get multiples of it).
# RATE_SIGNUP_PER_HOUR=10
# RATE_RECOVERY_PER_HOUR=20
# Failed web sign-ins per IP in 15 minutes before that IP is refused for a while.
# LOGIN_MAX_FAILS_PER_IP=50
# Which proxies the gateway trusts for the client IP (Express trust proxy syntax). Default: loopback.
# TRUST_PROXY=loopback
# How often the work module removes uploads that were started but never completed, in ms (default: 10 min).
# FILE_SWEEP_INTERVAL_MS=600000

# ── Features ────────────────────────────────────────────────────────────────
# Features to leave out of this installation, separated by commas: docs, whiteboards, calendar, time, ai.
# A feature left out disappears from the app (menus, pages, search) and its API answers 404; its data is kept, so
# removing the name and restarting brings it back. Chat and tasks are always on. Empty: everything is on.
#   docs         documents and the file drive          whiteboards  whiteboards
#   calendar     calendar, events, meeting notes       time         attendance and leave
#   ai           the company assistant, AI Insights (browser extension), agents and workflows, the AI section
# DISABLED_FEATURES=whiteboards,calendar

# ── Public API ──────────────────────────────────────────────────────────────
# 1 = serve the OpenAPI document and a viewer at /api/docs (docs/api/openapi.json is the same file). Off by default.
# API_DOCS=1
# The MCP endpoint for AI agents is always at /api/mcp and needs an API key (docs/integrations/mcp.md).

# ── Events and retention (daily jobs, batched) ──────────────────────────────
# Days each module keeps published events in its outbox, the copy events are replayed from (default 3).
# EVENT_RETENTION_DAYS=3
# Days each consumer keeps its processed-event ledger (dedupe of redelivered events; minimum 8).
# PROCESSED_EVENTS_RETENTION_DAYS=30
# What grows forever otherwise: the inbox, Home items, activity feeds, task history.
# NOTIFICATIONS_READ_RETENTION_DAYS=90
# NOTIFICATIONS_UNREAD_RETENTION_DAYS=180
# HOME_ITEMS_RETENTION_DAYS=180
# ACTIVITY_RETENTION_DAYS=365
# PUSH_RECENT_RETENTION_DAYS=30
# TASK_ACTIVITY_RETENTION_DAYS=365
# Browser errors reported by the web app's error screen (Admin › Lỗi trình duyệt).
# CLIENT_ERRORS_RETENTION_DAYS=30
# Attendance: an entry open longer than this many hours is a forgotten check-out, closed with no hours (4–24).
# ATTENDANCE_MAX_SHIFT_HOURS=16
# AI Insights side tables (daily job): who opened whose conversation, sensitive-data safety events, the agent audit.
# Conversations themselves follow the company's retention in Admin › AI.
# AI_VIEWS_RETENTION_DAYS=365
# AI_SAFETY_RETENTION_DAYS=365
# AI_AUDIT_RETENTION_DAYS=365

# ── Email (identity, home, ai; backend/packages/service-kit/src/mailer.ts) ─────
# The company's SMTP server, in development too (there is no local mail catcher). Without SMTP_URL nothing is
# sent: invites and password resets are handed over as links, and the daily digest is off.
# To test by hand, invite or reset an address at yopmail.com (public throwaway inboxes) and open it there.
# SMTP_URL=smtp://user:password@smtp.example.com:587   # smtps://…:465 for implicit TLS; URL-encode the password
# MAIL_FROM=workspace <no-reply@example.com>
# Automated tests only (ignored in production): write each email as a JSON file here instead of sending it.
# The backend tests set it themselves; the end-to-end suite needs it on the server it tests.
# MAIL_OUTBOX_DIR=/tmp/workspace-mail

# ── Logs ───────────────────────────────────────────────────────────────────────
# JSON lines on stdout, each with the request id (also in every error body and the x-request-id header).
# Who did what in the workspace is in the audit log (Admin › Nhật ký).
# LOG_LEVEL=info
# The `service` field on every log line.
# SERVICE_NAME=workspace

# ── Development only ──────────────────────────────────────────────────────────
# Lets webhooks and link previews reach http:// and private addresses (a local test receiver). Never in production.
# WEBHOOK_ALLOW_PRIVATE=1

# ── Web sessions ───────────────────────────────────────────────────────────────
# The web app keeps sign-in sessions in Postgres (schema `web`, its own role workspace_web). Default: local dev.
# WEB_DATABASE_URL=postgres://workspace_web:app_pw@localhost:5432/workspace
# Session ids are stored keyed with SESSION_SECRET (default: a public development value; the Docker image refuses to
# start the web app without 32+ random characters). Read by the web app's own environment, not by dev-server.mjs.
# SESSION_SECRET=

# ── Modules (ADR 0021; defaults fit `pnpm dev:server`) ─────────────────────────
# One process: PORT 4000 (gateway /api, Socket.IO, /storage) and INTERNAL_PORT 4001 on 127.0.0.1 (each module's API
# at /<module>). Modules reach each other in memory; <MODULE>_URL (e.g. WORK_URL=http://localhost:4001/work) only
# matters for tools and tests. Each module connects as its own role: <MODULE>_DATABASE_URL (see infra/production).
# PORT=4000
# INTERNAL_PORT=4001

# ── Public demo (infra/demo; off unless DEMO_MODE=1) ────────────────────────────
# Banner, quick sign-in as the seeded owner / minh@example.com / bao@example.com, admin actions locked by the
# gateway, per-IP limits. The server refuses to start without DEMO_OWNER_PASSWORD and DEMO_PASSWORD.
# DEMO_MODE=1
# DEMO_OWNER_EMAIL=admin@example.com
# DEMO_OWNER_PASSWORD=
# DEMO_PASSWORD=
# DEMO_SEED_SECRET=
# DEMO_RATE_PER_IP_PER_MIN=120
# Demo seed (pnpm seed:demo, a 100-person company in English): the workspace's UTC offset in hours for meeting and
# check-in times (default 0). Where the history (AI Insights, attendance) is written (owner role), default MIGRATE_DATABASE_URL.
# SEED_TZ_OFFSET=0
# SEED_DATABASE_URL=

# ── Retention of the operational tables (daily jobs, batched; set 0 to keep for one day, never less) ──────────
# Admin audit trail (Admin › Audit log): two years by default, it is the record of who changed what.
# AUDIT_LOG_RETENTION_DAYS=730
# Admin › Nhật ký: the audit trail of every module (ADR 0025).
# AUDIT_TRAIL_RETENTION_DAYS=365
# Settled webhook deliveries; each webhook keeps its newest delivery for the Admin › Webhooks view.
# WEBHOOK_DELIVERIES_RETENTION_DAYS=30
# Dead letters (events a consumer gave up on, `pnpm ops:dlq`), replayed or not; check `dlq list` well before.
# DEAD_EVENTS_RETENTION_DAYS=90
